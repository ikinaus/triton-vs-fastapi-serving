name: "titanic_ensemble"
platform: "ensemble"
max_batch_size: 32

input [
  { name: "Pclass",   data_type: TYPE_INT32,  dims: [ 1 ] },
  { name: "Name",     data_type: TYPE_STRING, dims: [ 1 ] },
  { name: "Sex",      data_type: TYPE_STRING, dims: [ 1 ] },
  { name: "Age",      data_type: TYPE_FP32,   dims: [ 1 ], optional: true },
  { name: "SibSp",    data_type: TYPE_INT32,  dims: [ 1 ] },
  { name: "Parch",    data_type: TYPE_INT32,  dims: [ 1 ] },
  { name: "Ticket",   data_type: TYPE_STRING, dims: [ 1 ] },
  { name: "Fare",     data_type: TYPE_FP32,   dims: [ 1 ], optional: true },
  { name: "Cabin",    data_type: TYPE_STRING, dims: [ 1 ], optional: true },
  { name: "Embarked", data_type: TYPE_STRING, dims: [ 1 ], optional: true }
]


output [
  { name: "label", data_type: TYPE_INT64, dims: [ ] }
  { name: "probabilities", data_type: TYPE_FP32, dims: [ 2 ] }
]

ensemble_scheduling {
  step [
    {
      model_name: "feature_extractor"
      model_version: -1
      input_map { key: "Pclass"   value: "Pclass" }
      input_map { key: "Name"     value: "Name" }
      input_map { key: "Sex"      value: "Sex" }
      input_map { key: "Age"      value: "Age" }
      input_map { key: "SibSp"    value: "SibSp" }
      input_map { key: "Parch"    value: "Parch" }
      input_map { key: "Ticket"   value: "Ticket" }
      input_map { key: "Fare"     value: "Fare" }
      input_map { key: "Cabin"    value: "Cabin" }
      input_map { key: "Embarked" value: "Embarked" }
      output_map { key: "Pclass"       value: "f_Pclass" }
      output_map { key: "Age"          value: "f_Age" }
      output_map { key: "SibSp"        value: "f_SibSp" }
      output_map { key: "Parch"        value: "f_Parch" }
      output_map { key: "Fare"         value: "f_Fare" }
      output_map { key: "HasCabin"     value: "f_HasCabin" }
      output_map { key: "CabinCount"   value: "f_CabinCount" }
      output_map { key: "GroupSize"    value: "f_GroupSize" }
      output_map { key: "NameLen"      value: "f_NameLen" }
      output_map { key: "Sex"          value: "f_Sex" }
      output_map { key: "Embarked"     value: "f_Embarked" }
      output_map { key: "Deck"         value: "f_Deck" }
      output_map { key: "TicketPrefix" value: "f_TicketPrefix" }
      output_map { key: "Title"        value: "f_Title" }
    },
    {
      model_name: "titanic_classifier"
      model_version: -1
      input_map { key: "Pclass"       value: "f_Pclass" }
      input_map { key: "Age"          value: "f_Age" }
      input_map { key: "SibSp"        value: "f_SibSp" }
      input_map { key: "Parch"        value: "f_Parch" }
      input_map { key: "Fare"         value: "f_Fare" }
      input_map { key: "HasCabin"     value: "f_HasCabin" }
      input_map { key: "CabinCount"   value: "f_CabinCount" }
      input_map { key: "GroupSize"    value: "f_GroupSize" }
      input_map { key: "NameLen"      value: "f_NameLen" }
      input_map { key: "Sex"          value: "f_Sex" }
      input_map { key: "Embarked"     value: "f_Embarked" }
      input_map { key: "Deck"         value: "f_Deck" }
      input_map { key: "TicketPrefix" value: "f_TicketPrefix" }
      input_map { key: "Title"        value: "f_Title" }
      output_map { key: "label"         value: "label" }
      output_map { key: "probabilities" value: "probabilities" }
    }
  ]
}